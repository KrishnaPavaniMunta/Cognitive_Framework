<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/chevi/ontologies/2026/5/untitle/"
     xml:base="http://www.semanticweb.org/chevi/ontologies/2026/5/untitle/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:classes-ontology="http://www.semanticweb.org/chevi/ontologies/2026/5/52-classes-ontology#"
     xmlns:untitled-ontology-6="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/chevi/ontologies/2026/5/52-classes-ontology"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/chevi/ontologies/2026/5/52-classes-ontology#causes -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/chevi/ontologies/2026/5/52-classes-ontology#causes">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#HazardEvent"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#Hazard"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/chevi/ontologies/2026/5/52-classes-ontology#hasObject -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/chevi/ontologies/2026/5/52-classes-ontology#hasObject">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/chevi/ontologies/2026/5/52-classes-ontology#Statement"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/chevi/ontologies/2026/5/52-classes-ontology#hasPredicate -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/chevi/ontologies/2026/5/52-classes-ontology#hasPredicate">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/chevi/ontologies/2026/5/52-classes-ontology#Statement"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/chevi/ontologies/2026/5/52-classes-ontology#Predicate"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/chevi/ontologies/2026/5/52-classes-ontology#hasSubject -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/chevi/ontologies/2026/5/52-classes-ontology#hasSubject">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/chevi/ontologies/2026/5/52-classes-ontology#Statement"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/chevi/ontologies/2026/5/52-classes-ontology#isEvidenceFor -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/chevi/ontologies/2026/5/52-classes-ontology#isEvidenceFor">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/chevi/ontologies/2026/5/52-classes-ontology#Statement"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#Role"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#blocks -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#blocks">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#Hazard"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#Obstacle"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#Infrastructure"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#SafetyEquipment"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#existsIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#existsIn">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#PhysicalObject"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#Context"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#hasLocation -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#hasLocation">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#HazardEvent"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#Person"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#PhysicalObject"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#Location"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#involves -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#involves">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#Event"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#Person"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#isAt -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#isAt">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#Role"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#Location"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#isDeterminedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#isDeterminedBy">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#Role"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#Context"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#playsRole -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#playsRole">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#Person"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#PhysicalObject"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#Role"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#threatens -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#threatens">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#Hazard"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#Person"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#triggersAlert -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#triggersAlert">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#HazardEvent"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#Role"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#Alert"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/chevi/ontologies/2026/5/52-classes-ontology#detectedAt -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/chevi/ontologies/2026/5/52-classes-ontology#detectedAt">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/chevi/ontologies/2026/5/52-classes-ontology#Statement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/chevi/ontologies/2026/5/52-classes-ontology#hasConfidence -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/chevi/ontologies/2026/5/52-classes-ontology#hasConfidence">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/chevi/ontologies/2026/5/52-classes-ontology#Statement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    </owl:DatatypeProperty>
    


    <!-- Structured physical-size knowledge used by RGB-D false-positive filtering. Values are in metres. -->

    <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/chevi/ontologies/2026/5/52-classes-ontology#physicalDimensions"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/chevi/ontologies/2026/5/52-classes-ontology#ContaminationHazard -->

    <owl:Class rdf:about="http://www.semanticweb.org/chevi/ontologies/2026/5/52-classes-ontology#ContaminationHazard">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#Hazard"/>
                    <owl:Restriction>
                        <owl:onProperty>
                            <rdf:Description>
                                <owl:inverseOf rdf:resource="http://www.semanticweb.org/chevi/ontologies/2026/5/52-classes-ontology#causes"/>
                            </rdf:Description>
                        </owl:onProperty>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#spillage"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#Hazard"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/chevi/ontologies/2026/5/52-classes-ontology#FireHazard -->

    <owl:Class rdf:about="http://www.semanticweb.org/chevi/ontologies/2026/5/52-classes-ontology#FireHazard">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#Hazard"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#blocks"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#SafetyEquipment"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#Hazard"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/chevi/ontologies/2026/5/52-classes-ontology#Predicate -->

    <owl:Class rdf:about="http://www.semanticweb.org/chevi/ontologies/2026/5/52-classes-ontology#Predicate"/>
    


    <!-- http://www.semanticweb.org/chevi/ontologies/2026/5/52-classes-ontology#Statement -->

    <owl:Class rdf:about="http://www.semanticweb.org/chevi/ontologies/2026/5/52-classes-ontology#Statement"/>
    


    <!-- http://www.semanticweb.org/chevi/ontologies/2026/5/52-classes-ontology#TrippingHazard -->

    <owl:Class rdf:about="http://www.semanticweb.org/chevi/ontologies/2026/5/52-classes-ontology#TrippingHazard">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#Hazard"/>
                    <owl:Restriction>
                        <owl:onProperty>
                            <rdf:Description>
                                <owl:inverseOf rdf:resource="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#playsRole"/>
                            </rdf:Description>
                        </owl:onProperty>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#PersonalBelonging"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#Hazard"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/chevi/ontologies/2026/5/52-classes-ontology#oxygen_pump -->

    <owl:Class rdf:about="http://www.semanticweb.org/chevi/ontologies/2026/5/52-classes-ontology#oxygen_pump">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#MedicalDevice"/>
        <rdfs:comment>Typical dimensions ≈ 35 × 60 × 30 cm (portable concentrator)</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/chevi/ontologies/2026/5/52-classes-ontology#switchboard -->

    <owl:Class rdf:about="http://www.semanticweb.org/chevi/ontologies/2026/5/52-classes-ontology#switchboard">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#Infrastructure"/>
        <classes-ontology:physicalDimensions>{"typical":{"width":0.6,"depth":0.2,"height":0.8},"range":{"width":[0.48,0.72],"depth":[0.16,0.24],"height":[0.64,0.96]}}</classes-ontology:physicalDimensions>
        <rdfs:comment>Typical dimensions ≈ 60 × 80 × 20 cm</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/chevi/ontologies/2026/5/52-classes-ontology#utility_trolley -->

    <owl:Class rdf:about="http://www.semanticweb.org/chevi/ontologies/2026/5/52-classes-ontology#utility_trolley">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#Furniture"/>
        <classes-ontology:physicalDimensions>{"typical":{"width":0.5,"depth":0.8,"height":0.95},"range":{"width":[0.4,0.6],"depth":[0.64,0.96],"height":[0.76,1.14]}}</classes-ontology:physicalDimensions>
        <rdfs:comment>Typical dimensions ≈ 50 × 95 × 80 cm (W × H × L)</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#Alert -->

    <owl:Class rdf:about="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#Alert">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#Event"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#HazardEvent"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#Context -->

    <owl:Class rdf:about="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#Context"/>
    


    <!-- http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#Environment -->

    <owl:Class rdf:about="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#Environment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#Location"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#EnvironmentContext -->

    <owl:Class rdf:about="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#EnvironmentContext">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#Context"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#Event -->

    <owl:Class rdf:about="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#Event"/>
    


    <!-- http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#Furniture -->

    <owl:Class rdf:about="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#Furniture">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#PhysicalObject"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#Hazard -->

    <owl:Class rdf:about="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#Hazard">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#Role"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#threatens"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#Person"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#HazardEvent -->

    <owl:Class rdf:about="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#HazardEvent">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#Event"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#IndoorSpace -->

    <owl:Class rdf:about="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#IndoorSpace">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#Location"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#Infrastructure -->

    <owl:Class rdf:about="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#Infrastructure">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#PhysicalObject"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#Location -->

    <owl:Class rdf:about="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#Location"/>
    


    <!-- http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#MedicalDevice -->

    <owl:Class rdf:about="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#MedicalDevice">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#PhysicalObject"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#MonitoredEntity -->

    <owl:Class rdf:about="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#MonitoredEntity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#Role"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#Obstacle -->

    <owl:Class rdf:about="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#Obstacle">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#Role"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#blocks"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#Infrastructure"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#Patient -->

    <owl:Class rdf:about="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#Patient">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/chevi/ontologies/2026/5/untitled-ontology-6#Person"/>
        <rdfs:comment>Typical dimensions ≈ 50 × 170 × 30 cm standing; ~200 cm lying</rdfs:comment>
    </owl:Class>
    


